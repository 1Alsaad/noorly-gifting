# Local demo: copy to .env.local. Do not commit .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=NOORLY
NEXT_PUBLIC_DEFAULT_LOCALE=sv
NEXT_PUBLIC_COMMERCE_PROVIDER=mock
# Search indexing is enabled only for production + real Shopify; previews stay noindex.
DEPLOYMENT_ENV=development
# REQUIRED to run a production build as an explicitly marked mock preview.
# Real launches must set provider=shopify, ALLOW_MOCK_COMMERCE=false and HTTPS site URL.
ALLOW_MOCK_COMMERCE=false
CART_COOKIE_SECRET=

SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=

NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_API_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
# Use the EU ingestion host for an EU project, e.g. https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Redis REST credentials; mandatory for production public mutations and paid-order outbox.
RATE_LIMIT_PROVIDER_URL=
RATE_LIMIT_PROVIDER_TOKEN=
# POST JSON delivery adapter; must honor Idempotency-Key; absent = explicit dev mock / production 503.
FORM_DELIVERY_URL=
FORM_DELIVERY_TOKEN=
# Optional vendor-neutral analytics relay; must honor Idempotency-Key.
ANALYTICS_DELIVERY_URL=
ANALYTICS_DELIVERY_TOKEN=
# Random 32+ character bearer secret for POST /api/webhooks/drain from your scheduler.
OUTBOX_CRON_SECRET=

# Public product test is the default. Only set false for an approved commerce launch.
NEXT_PUBLIC_PRODUCT_TEST_MODE=true
# Keep registrations closed until privacy/contact, durable storage and delivery are verified.
PRODUCT_INTEREST_ENABLED=false
# Public pixel ID, not an access token. Load only after marketing consent.
NEXT_PUBLIC_META_PIXEL_ID=
