# Deployment template for Noorly. Copy into the hosting provider's secret settings.
# Credentials stay blank until supplied by the account owner; this file is not a working connection.
# Apply the final origin only after its DNS and HTTPS are verified, then rebuild.
NEXT_PUBLIC_SITE_URL=https://noorlynordic.com
NEXT_PUBLIC_BRAND_NAME=NOORLY
NEXT_PUBLIC_DEFAULT_LOCALE=sv
NEXT_PUBLIC_COMMERCE_PROVIDER=shopify
# Keep preview/noindex until the live integrations and launch checklist pass.
DEPLOYMENT_ENV=preview
ALLOW_MOCK_COMMERCE=false
# Release only after docs/project-handover/Noorly_Presale_State_v1.2.md gates pass.
# Unset/false keeps every public production build closed, including preview builds.
NOORLY_STOREFRONT_OPEN=false
# Keep interest-only controls until commerce, fulfilment and checkout are verified.
# This public setting is baked into the client build; changing it needs a rebuild.
NEXT_PUBLIC_PRODUCT_TEST_MODE=true

SHOPIFY_STORE_DOMAIN=
# Public Storefront access token from Shopify's Headless channel. Used only by the server adapter.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=

# Generate unique random values; never reuse the CI dummy secret.
CART_COOKIE_SECRET=
OUTBOX_CRON_SECRET=
RATE_LIMIT_PROVIDER_URL=
RATE_LIMIT_PROVIDER_TOKEN=
# Alternatively, the native Vercel integration supplies KV_REST_API_URL and
# KV_REST_API_TOKEN. Both explicit RATE_LIMIT values must be blank/unset to use
# that matched pair. KV_URL, REDIS_URL and the read-only token are not used.
FORM_DELIVERY_URL=
FORM_DELIVERY_TOKEN=

# Optional: enable providers only after account setup and consent verification.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Existing Noorly-owned Meta dataset, production only; load after marketing consent.
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only Meta Purchase events; require a reviewed API version + secret token.
# Do not paste real access tokens into the repository or chat.
META_CAPI_ACCESS_TOKEN=
META_CAPI_API_VERSION=
GA4_API_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
ANALYTICS_DELIVERY_URL=
ANALYTICS_DELIVERY_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
