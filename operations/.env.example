# Copy to a private host environment, never commit real values.
# Free/local development uses OPS_DEMO=true and does not call paid APIs or publish.
OPS_DEMO=false
DATABASE_URL=
OPS_OPERATOR_USER=noorly
OPS_OPERATOR_PASSWORD=
OPS_SERVICE_TOKEN=
CRON_SECRET=

# Vercel AI Gateway API access is independent of a ChatGPT/Codex subscription.
AI_GATEWAY_API_KEY=
OPS_AI_FUNDING=cash
OPS_USD_SEK=
OPS_FX_VERIFIED_AT=

SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=
NOORLY_CATALOG_TOKEN=
NOORLY_CATALOG_SIGNING_SECRET=

BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
BUFFER_TIKTOK_CHANNEL_ID=
BUFFER_TIKTOK_PHOTOS_VERIFIED=false
# Optional additional trusted image hosts, comma-separated. Shopify CDN is allowed by default.
OPS_ASSET_HOSTS=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPS_OWNER_EMAIL=
RESEND_FREE_PLAN_CONFIRMED=false

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
AW_API_TOKEN=
AW_API_ENVIRONMENT=staging
AW_FULFILLMENT_MODE=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=

# Separate disposable database only; integration tests mutate their own schema.
OPS_TEST_DATABASE_URL=
OPS_BACKUP_DIRECTORY=.data/backups
