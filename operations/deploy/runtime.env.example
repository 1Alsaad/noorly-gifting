# Copy to runtime.env on the host only. Never commit the populated file.
# Use at least 32 random base64url characters for each secret. In particular,
# POSTGRES_PASSWORD must be URL-safe because it becomes part of DATABASE_URL.
POSTGRES_PASSWORD=
OPS_OPERATOR_USER=noorly
OPS_OPERATOR_PASSWORD=
OPS_SERVICE_TOKEN=
CRON_SECRET=
NOORLY_CATALOG_TOKEN=
NOORLY_CATALOG_SIGNING_SECRET=

# Use a hostname already owned by Noorly; do not buy a domain for this setup.
# Set DNS to the host before enabling the compose https profile.
OPS_PUBLIC_HOST=localhost

# Integration credentials are intentionally absent. Add only authorized
# connections from operations/.env.example when they are ready for use.
# Do not assume that free hosting makes model or connector API calls free.
